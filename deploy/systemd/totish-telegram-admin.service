[Unit]
Description=TOTISH Telegram Admin Panel poller
After=default.target

[Service]
WorkingDirectory=/opt/football-totalizator
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 scripts/telegram_admin_bot.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
